# Required for speech recognition, language generation, synthesis and optional semantic embeddings.
OPENAI_API_KEY=your_api_key_here

# Voice pipeline: configured for Persian / fa-IR
VOICE_RAG_STT_MODEL=gpt-4o-mini-transcribe
VOICE_RAG_LLM_MODEL=gpt-4.1-mini
VOICE_RAG_TTS_MODEL=gpt-4o-mini-tts
VOICE_RAG_TTS_VOICE=ash
VOICE_RAG_LANGUAGE=fa
VOICE_RAG_INDEX=./data/knowledge-index.json
VOICE_RAG_SEMANTIC_QUERY=auto

# Only for the optional hosted LiveKit room/web frontend, not console mode:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
